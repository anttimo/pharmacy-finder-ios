{
  "sourceLanguage" : "en",
  "strings" : {
    "app.intro" : {
      "comment" : "Intro under the title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the pharmacies closest to you by using your location or entering an address."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löydä lähimmät apteekit käyttämällä sijaintiasi tai antamalla osoite."
          }
        }
      }
    },
    "app.title" : {
      "comment" : "The screen's title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the nearest pharmacy"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löydä lähin apteekki"
          }
        }
      }
    },
    "denied.body" : {
      "comment" : "Under \"Location access is turned off.\": how to allow location, also when Location Services are off for the whole device. It doesn't name the path in Settings, since that can change between iOS versions.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use your location, allow location access for this app in Settings, then tap “Use my location” again. If Location Services are off for the whole phone, turn them on."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos haluat käyttää sijaintiasi, salli sijainnin käyttö tälle sovellukselle asetuksista ja paina sitten uudelleen ”Käytä sijaintiani”. Jos sijaintipalvelut ovat pois päältä koko puhelimesta, laita ne päälle."
          }
        }
      }
    },
    "error.locationBody" : {
      "comment" : "Under \"We couldn't get your location.\": what to check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that Location Services are on, then try again."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista, että sijaintipalvelut ovat käytössä, ja yritä uudelleen."
          }
        }
      }
    },
    "error.retry" : {
      "comment" : "Button that tries again to get the location, or to search for the place.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try again"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yritä uudelleen"
          }
        }
      }
    },
    "error.searchBody" : {
      "comment" : "Under \"We couldn't search for the place.\": what to check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your internet connection, then try again."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista internetyhteys ja yritä uudelleen."
          }
        }
      }
    },
    "footer.locations %@" : {
      "comment" : "Footer: credit required by Digitransit's terms (CC BY), which geocoded the pharmacies. The placeholder is the current year. Address search is Apple's on iOS, so unlike the web it isn't credited here (ADR 0003).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pharmacy locations: © [Digitransit](https://digitransit.fi/) %@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apteekkien sijainnit: © [Digitransit](https://digitransit.fi/) %@"
          }
        }
      }
    },
    "footer.osm" : {
      "comment" : "Footer: notice required by ODbL section 4.3, following its example text. Markdown links.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contains information from [OpenStreetMap](https://www.openstreetmap.org/copyright), which is made available here under the [Open Database License (ODbL)](https://opendatacommons.org/licenses/odbl/1-0/)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisältää tietoja [OpenStreetMapista](https://www.openstreetmap.org/copyright), jonka tiedot ovat saatavilla [Open Database License (ODbL)](https://opendatacommons.org/licenses/odbl/1-0/) -lisenssillä."
          }
        }
      }
    },
    "footer.source" : {
      "comment" : "Footer: where the pharmacy data comes from. Markdown link to the THL CodeServer.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pharmacy data source: Finnish Medicines Agency (Fimea) / [THL CodeServer (Kanta Services)](https://koodistopalvelu.kanta.fi/)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apteekkitietojen lähde: Lääkealan turvallisuus- ja kehittämiskeskus Fimea / [THL Koodistopalvelu](https://koodistopalvelu.kanta.fi/)"
          }
        }
      }
    },
    "footer.updated %@" : {
      "comment" : "Footer: when the pharmacy list was generated. The placeholder is a date, such as \"16 November 2026\".",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pharmacy data updated %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apteekkitiedot päivitetty %@."
          }
        }
      }
    },
    "locate.button" : {
      "comment" : "The button that finds pharmacies near the user.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use my location"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä sijaintiani"
          }
        }
      }
    },
    "noMatches.body" : {
      "comment" : "Under \"No place found in Finland.\": what to try instead.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the spelling, or try a street or town nearby."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista kirjoitusasu tai kokeile lähellä olevaa katua tai kuntaa."
          }
        }
      }
    },
    "results.approximate" : {
      "comment" : "Above the results when the user shared only an approximate location and didn't allow a precise one.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is approximate, so these may not be the nearest pharmacies. For exact results, turn on Precise Location for this app in Settings."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijaintisi on likimääräinen, joten nämä eivät välttämättä ole lähimmät apteekit. Saat tarkemmat tulokset, kun laitat tarkan sijainnin päälle tälle sovellukselle asetuksista."
          }
        }
      }
    },
    "results.call %@" : {
      "comment" : "VoiceOver label of the button that calls a pharmacy. The placeholder is its phone number.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Call %@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soita %@"
          }
        }
      }
    },
    "results.distance %@" : {
      "comment" : "A pharmacy's distance, such as \"1,2 km\", measured in a straight line.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in a straight line"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ linnuntietä"
          }
        }
      }
    },
    "results.heading" : {
      "comment" : "Heading above the pharmacies nearest to the user.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pharmacies near you"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähellä olevat apteekit"
          }
        }
      }
    },
    "results.headingPlace %@" : {
      "comment" : "Heading above the pharmacies nearest to a place the user chose. The placeholder is the place, such as \"Kamppi\" or \"Mannerheimintie 1\".",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pharmacies near %@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähimmät apteekit: %@"
          }
        }
      }
    },
    "results.map" : {
      "comment" : "Button that opens the pharmacy in Apple Maps.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show in Maps"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä kartalla"
          }
        }
      }
    },
    "results.notes" : {
      "comment" : "Under the results heading, small: opening hours aren't in the data, and how distances are measured.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check opening hours with the pharmacy. Distances are measured in a straight line."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista aukioloajat apteekista. Etäisyydet on mitattu linnuntietä."
          }
        }
      }
    },
    "results.rowLabel %@ %@ %@" : {
      "comment" : "What VoiceOver reads for one pharmacy: its name, the spelled-out distance and the address.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ in a straight line, %3$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ linnuntietä, %3$@"
          }
        }
      }
    },
    "search.error" : {
      "comment" : "Under the search field when Apple's place search couldn't be reached.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Address search isn't working right now. Try again, or use your location."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoitehaku ei toimi juuri nyt. Yritä uudelleen tai käytä sijaintiasi."
          }
        }
      }
    },
    "search.label" : {
      "comment" : "Label of the address or place search field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Address or place"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoite tai paikka"
          }
        }
      }
    },
    "search.noMatches" : {
      "comment" : "Under the search field when no place in Finland matches the text.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No places found in Finland. Check the spelling, or try a street or town nearby."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikkoja ei löytynyt Suomesta. Tarkista kirjoitusasu tai kokeile lähellä olevaa katua tai kuntaa."
          }
        }
      }
    },
    "search.or" : {
      "comment" : "Between the \"Use my location\" button and the search field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "or"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tai"
          }
        }
      }
    },
    "search.privacy" : {
      "comment" : "Under the search field: what happens to the text the user types.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you type is sent to Apple's place search."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoittamasi teksti lähetetään Applen paikkahakuun."
          }
        }
      }
    },
    "search.prompt" : {
      "comment" : "Example text in the empty search field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e.g. Mannerheimintie 1, Helsinki"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "esim. Mannerheimintie 1, Helsinki"
          }
        }
      }
    },
    "settings.open" : {
      "comment" : "Button that opens this app's page in the Settings app.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa Asetukset"
          }
        }
      }
    },
    "status.denied" : {
      "comment" : "Status when the app may not use the location, or Location Services are off.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is turned off."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijainnin käyttö on estetty."
          }
        }
      }
    },
    "status.found %lld" : {
      "comment" : "Status above the results. The placeholder is how many are shown.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Showing the nearest pharmacy."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Showing the %lld nearest pharmacies."
                }
              }
            }
          }
        },
        "fi" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Näytetään lähin apteekki."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Näytetään %lld lähintä apteekkia."
                }
              }
            }
          }
        }
      }
    },
    "status.loading" : {
      "comment" : "Status after the location is known or a place is chosen, while the nearest pharmacies are found.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looking for nearby pharmacies…"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haetaan lähellä olevia apteekkeja…"
          }
        }
      }
    },
    "status.locating" : {
      "comment" : "Status while waiting for the device's location.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finding your location…"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haetaan sijaintiasi…"
          }
        }
      }
