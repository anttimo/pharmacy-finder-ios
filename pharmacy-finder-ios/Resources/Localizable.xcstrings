            "state" : "translated",
            "value" : "No place found in Finland."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikkaa ei löytynyt Suomesta."
          }
        }
      }
    },
    "status.searchError" : {
      "comment" : "Status when Apple's place search couldn't be reached.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't search for the place."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
